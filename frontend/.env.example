# demo = built-in sample data, no backend or login needed (default)
# live = real Supabase sign-in + the FastAPI endpoints listed in src/api/index.ts
# Release builds (APP_VARIANT / EAS_BUILD_PROFILE / NODE_ENV = production) refuse to build
# unless API_MODE=live, API_URL is https://, both Supabase values are set and the RevenueCat
# key below starts with goog_ (app.config.js).
EXPO_PUBLIC_API_MODE=demo
# localhost works on a phone too: the app swaps in the PC Metro serves it from (src/lib/apiUrl.ts).
EXPO_PUBLIC_API_URL=http://localhost:8001
EXPO_PUBLIC_SUPABASE_URL=https://jsvgezmgvwnldcnrjdzg.supabase.co
# Publishable (anon) key — public by design. Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# RevenueCat public SDK key for Google Play (starts with goog_), from the RevenueCat dashboard. Public by
# design; never put the secret API key here. Empty = Lately Pro can't be bought in this build (docs/billing-setup.md).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
