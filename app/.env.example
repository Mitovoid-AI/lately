# Supabase — copy to .env and fill with your project values.
# Get these from Supabase dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Phase 1 only: a single seeded user id (UUID) that owns all saves.
EXPO_PUBLIC_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Groq — audio transcription (Whisper). Free key: https://console.groq.com
EXPO_PUBLIC_GROQ_API_KEY=your-groq-key

# Gemini — content structuring (title/summary/category/tags). Free key:
# https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-key
