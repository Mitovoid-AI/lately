# Server-side only. Never expose these to the browser.
# Copy to website/.env.local and fill in.

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# ⚠️ service_role bypasses Row Level Security. Server-side only, never in a
# client component, never in the mobile app bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram — create a bot with @BotFather, it gives you this token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# AI (optional). Without these, saves still work but cards stay "partial".
# Groq:   https://console.groq.com
# Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
