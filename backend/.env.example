# Lately backend — environment template
# Copy to .env (git-ignored) and fill in. Never commit .env or paste keys in chat.
# [Phase N] = when a value is first needed. Tests never need real keys.

# ---------------------------------------------------------------- database [Phase 0]
# Local: printed by `supabase start` (run from repo root).
# Cloud qa/prod: Supabase dashboard -> Connect -> Transaction pooler URI (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_MAX_SIZE=10

# ---------------------------------------------------------------- supabase [Phase 0]
# Local: `supabase status` -> API URL and service_role key.
# Cloud: dashboard -> Project Settings -> API.
SUPABASE_URL=http://127.0.0.1:54321
# Server-side only. Never ship to a client app or bundle.
SUPABASE_SERVICE_ROLE_KEY=
# The `aud` claim on Supabase user tokens.
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------- catch-path limits
RATE_LIMIT_PER_HOUR=30

# ---------------------------------------------------------------- worker
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_STUCK_AFTER_MINUTES=10
WORKER_CONCURRENCY=8
WORKER_HEARTBEAT_SECONDS=30

# ---------------------------------------------------------------- embeddings [Phase 1]
# Any OpenAI-compatible /embeddings endpoint. Used for real-vector search eval and
# production search. Empty key = search runs keyword + fuzzy only.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
# Must match the reels.embedding column: vector(768).
EMBEDDINGS_DIMENSIONS=768
SEARCH_EMBED_TIMEOUT_SECONDS=2.0

# ---------------------------------------------------------------- LLM [Phase 2]
# Any OpenAI-compatible chat-completions endpoint. Starts on OpenRouter free models;
# moving to a paid model/provider later is an env change, not a code change.
# Free models end in ":free" -> https://openrouter.ai/models?max_price=0
# Pick one that supports JSON output AND image input (thumbnail -> visual_description).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=

# ---------------------------------------------------------------- transcription [Phase 2, optional]
# Groq Whisper (free tier: console.groq.com). Empty = skip TRANSCRIBE;
# cards are built from caption + thumbnail only.
GROQ_API_KEY=
