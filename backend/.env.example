# Lately backend — environment template
# Copy to .env (git-ignored) and fill in. Never commit .env or paste keys in chat.
# [Phase N] = when a value is first needed. Tests never need real keys.

# ---------------------------------------------------------------- database [Phase 0]
# Local: printed by `supabase start` (run from repo root).
# Cloud qa/prod: Supabase dashboard -> Connect -> Transaction pooler URI (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Tests + scripts/db_reset.py: a DISPOSABLE database (tests truncate it).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_MAX_SIZE=10

# ---------------------------------------------------------------- supabase [Phase 0]
# Local: `supabase status` -> API URL and service_role key.
# Cloud: dashboard -> Project Settings -> API.
SUPABASE_URL=http://127.0.0.1:54321
# Server-side only. Never ship to a client app or bundle.
SUPABASE_SERVICE_ROLE_KEY=
# The `aud` claim on Supabase user tokens.
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------- catch-path limits
RATE_LIMIT_PER_HOUR=30

# ---------------------------------------------------------------- worker
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_STUCK_AFTER_MINUTES=10
WORKER_CONCURRENCY=8
WORKER_HEARTBEAT_SECONDS=30

# ---------------------------------------------------------------- embeddings [Phase 1]
# Any OpenAI-compatible /embeddings endpoint. Used for real-vector search eval and
# production search. Empty key = search runs keyword + fuzzy only.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
# Must match the reels.embedding column: vector(768).
EMBEDDINGS_DIMENSIONS=768
SEARCH_EMBED_TIMEOUT_SECONDS=2.0

# ---------------------------------------------------------------- LLM [Phase 2]
# Any OpenAI-compatible chat-completions endpoint. Starts on OpenRouter free models;
# moving to a paid model/provider later is an env change, not a code change.
# Free models end in ":free" -> https://openrouter.ai/models?max_price=0
# Pick one that supports JSON output AND image input (thumbnail -> visual_description).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
# Tried in order when LLM_MODEL errors or is rate limited (comma-separated).
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=60
# Cost estimate per million tokens, used for metrics when the provider does not
# return usage.cost (free models: leave 0).
LLM_COST_PER_MTOK_IN_USD=0
LLM_COST_PER_MTOK_OUT_USD=0

# ---------------------------------------------------------------- transcription [Phase 2, optional]
# Groq Whisper (free tier: console.groq.com). Empty = skip TRANSCRIBE;
# cards are built from caption + thumbnail only.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_COST_PER_HOUR_USD=0.04
# Transcribe only short reels with weak captions; Groq's upload limit is 25 MB.
TRANSCRIBE_MAX_DURATION_S=180
TRANSCRIBE_CAPTION_MAX_WORDS=40
TRANSCRIBE_MAX_BYTES=25000000

# ---------------------------------------------------------------- fetch [Phase 2]
# Provider chain: Instagram embed page -> yt-dlp (metadata only) -> paid scraper.
# All fail = card is "partial" (caption-only or empty) and still finalized.
FETCH_TIMEOUT_SECONDS=15
YTDLP_ENABLED=true
# Optional paid scraper: GET {SCRAPER_API_URL}?url=<reel url> with
# "Authorization: Bearer {SCRAPER_API_KEY}", returning JSON with caption,
# owner.username, display_url, video_url, video_duration. Empty = disabled.
SCRAPER_API_URL=
SCRAPER_API_KEY=
# Thumbnails are copied to Storage bucket `thumbnails` (needs
# SUPABASE_SERVICE_ROLE_KEY); without the key the remote URL is stored instead.
THUMBNAIL_MAX_BYTES=2000000
# Signed Instagram media URLs older than this are re-fetched before transcribing.
MEDIA_URL_MAX_AGE_SECONDS=1800
# Rate limits per provider live in the database (table provider_budget, 0007):
#   update public.provider_budget set per_minute = 20 where provider = 'llm';
